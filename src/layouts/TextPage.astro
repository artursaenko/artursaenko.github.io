---
import Base from "./Base.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { paths, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  alternate?: string;
  noindex?: boolean;
}
const { lang, title, description, alternate, noindex } = Astro.props;
const other: Lang = lang === "de" ? "en" : "de";
---

<Base lang={lang} title={title} description={description} alternate={alternate} noindex={noindex}>
  <header class="text-top">
    <div class="wrap row">
      <a class="brand" href={paths[lang].home}>Artur Saienko</a>
      <div class="links">
        <a href={paths[lang].home}>{lang === "de" ? "← Zur Startseite" : "← Back to home"}</a>
        {
          alternate && (
            <a class="lang" href={alternate} hreflang={other} lang={other}>
              {other.toUpperCase()}
            </a>
          )
        }
      </div>
    </div>
  </header>
  <main id="main" class="narrow prose">
    <slot />
  </main>
  <SiteFooter lang={lang} />
</Base>

<style>
  .text-top {
    background: var(--dark);
    color: var(--on-dark);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .brand {
    color: var(--on-dark);
    text-decoration: none;
    font-size: 20px;
    font-weight: 600;
  }

  .links {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .links a {
    color: var(--on-dark);
    font-size: 15px;
  }

  .links a.lang {
    font-family: var(--mono);
    text-decoration: none;
    border: 1px solid var(--dark-line);
    border-radius: 8px;
    padding: 6px 10px;
  }
</style>
