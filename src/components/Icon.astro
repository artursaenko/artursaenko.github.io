---
// Small stroke icons, drawn inline so they follow the text colour.
interface Props {
  name: string;
  size?: number;
}
const { name, size = 22 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === "linkedin" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="3" />
        <line x1="8" y1="10.5" x2="8" y2="16" />
        <circle cx="8" cy="7.5" r="0.8" fill="currentColor" />
        <path d="M12 16v-5.5M12 13c0-1.6 1-2.7 2.3-2.7S16.5 11.2 16.5 13v3" />
      </>
    )
  }
  {
    name === "mail" && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <polyline points="3.5,6 12,13 20.5,6" />
      </>
    )
  }
  {
    name === "github" && (
      <>
        <polyline points="8,7 3,12 8,17" />
        <polyline points="16,7 21,12 16,17" />
        <line x1="13.5" y1="5" x2="10.5" y2="19" />
      </>
    )
  }
  {
    name === "file" && (
      <>
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
        <polyline points="14,3 14,8 19,8" />
        <line x1="12" y1="12" x2="12" y2="18" />
        <polyline points="9,15 12,18 15,15" />
      </>
    )
  }
  {
    name === "board" && (
      <>
        <rect x="3" y="4" width="18" height="13" rx="2" />
        <path d="M7 13c2-4 4 2 6-2s3 1 4 0" />
        <line x1="12" y1="17" x2="12" y2="21" />
      </>
    )
  }
  {
    name === "table" && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <line x1="3" y1="9" x2="21" y2="9" />
        <line x1="3" y1="15" x2="21" y2="15" />
        <line x1="9" y1="3" x2="9" y2="21" />
      </>
    )
  }
  {
    name === "check" && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M9 12l2 2 4-4" />
      </>
    )
  }
  {
    name === "badge" && (
      <>
        <circle cx="12" cy="9" r="5" />
        <path d="M9 13.5L8 21l4-2 4 2-1-7.5" />
      </>
    )
  }
  {
    name === "book" && (
      <>
        <path d="M4 19V5a2 2 0 0 1 2-2h12v18H6a2 2 0 0 1-2-2z" />
        <line x1="8" y1="7" x2="15" y2="7" />
      </>
    )
  }
  {
    name === "cap" && (
      <>
        <polygon points="12,4 22,9 12,14 2,9" />
        <path d="M6 11v5c3 2 9 2 12 0v-5" />
      </>
    )
  }
  {
    name === "headset" && (
      <>
        <path d="M4 14v-3a8 8 0 0 1 16 0v3" />
        <rect x="3" y="14" width="4" height="6" rx="1" />
        <rect x="17" y="14" width="4" height="6" rx="1" />
      </>
    )
  }
  {
    name === "box" && (
      <>
        <path d="M3 7l9-4 9 4-9 4z" />
        <path d="M3 7v10l9 4 9-4V7" />
        <line x1="12" y1="11" x2="12" y2="21" />
      </>
    )
  }
  {
    name === "arrow" && (
      <>
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="13,6 19,12 13,18" />
      </>
    )
  }
</svg>
